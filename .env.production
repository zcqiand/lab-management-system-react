# lab-management-system-react 生产环境变量(Vite build-time 烘焙)

# 后端地址 —— lab 家族 backend 切 lab-springboot (port 8013, nginx 反代到 8080)
VITE_API_BASE_URL=https://lab-springboot.xiangru.uk
VITE_API_MODE=springboot

# SSO/identity 仓
VITE_SAAS_BASE_URL=https://saas-nextjs.xiangru.uk
SAAS_BASE_URL=https://saas-nextjs.xiangru.uk

# Vite dev server 端口(与 .env.example 对齐;prod 构建不读,仅 key 集合一致)
VITE_DEV_PORT=5173