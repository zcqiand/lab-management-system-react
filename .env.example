# lab-management-system-react — 开发期环境变量模板
#
# 复制为 .env.local 后填实际值（.env 加入 .gitignore，不进 git）。
#
# ADR-0014：后端配置全部走 env，运行时不再切换。
# 删除了 msw / nextjs / aspnetcore / springboot 四模式运行时切换 + 4 个 VITE_BACKEND_URL_*；
# 后端塌缩到 VITE_API_BASE_URL 单 URL。MSW 启动门控走 VITE_ENABLE_MSW。
# saas-base-url 保留（lab → saas SSO 跳板仍需独立 env）。
#
# 默认后端约定（跨仓一致）：
#   react → springboot (:8080)
#   vue   → aspnetcore (:5000)

# —— Vite dev server 端口 ——
VITE_DEV_PORT=5173

# —— 后端 URL（ADR-0014：单 URL）——
# dev 默认填 springboot :8080（与跨仓 react 系列一致）；prod 由部署平台覆盖
VITE_API_BASE_URL=http://localhost:8080

# —— MSW Service Worker 启动开关（ADR-0014）——
# dev 默认 false（直走 springboot 真后端）；设 true 切回 MSW mock（同源拦截）
VITE_ENABLE_MSW=false

# —— mode 显示标签（ADR-0014：仅 UI 展示，不参与路由）——
VITE_API_MODE=springboot

# —— saas-identity-platform（SSO 跳转目标） ——
# msw handler 走 process.env.SAAS_BASE_URL；前端走 import.meta.env.VITE_SAAS_BASE_URL
# 本地 saas dev server 默认 :3000；改部署时填实际地址
VITE_SAAS_BASE_URL=http://localhost:3000
SAAS_BASE_URL=http://localhost:3000