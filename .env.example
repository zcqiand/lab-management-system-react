# lab-management-system-react — 开发期环境变量模板
#
# 复制为 .env.local 后填实际值（.env 加入 .gitignore，不进 git）。
#
# ADR-0014：后端配置全部走 env，运行时不再切换。
# 删除了 msw / nextjs / aspnetcore / springboot 四模式运行时切换 + 4 个 VITE_BACKEND_URL_*；
# 后端塌缩到 VITE_API_BASE_URL 单 URL。
# saas-base-url 保留（lab → saas SSO 跳板仍需独立 env）。
#
# 默认后端约定（跨仓一致）：
#   react → springboot (:8080)
#   vue   → aspnetcore (:5000)

# —— Vite dev server 端口 ——
VITE_DEV_PORT=5173

# —— 后端 URL（ADR-0014：单 URL + ADR-0012 B 强度）——
# dev 默认走独立 lab-msw HTTP server :5173（ADR-0012 B 强度，msw-http）
# 改成 http://localhost:8080 切到 springboot 真后端（ADR-0014 跨仓 react 系列默认）
# 改成 http://localhost:5000 切到 aspnetcore 真后端
VITE_API_BASE_URL=http://localhost:5173

# —— mode 显示标签（ADR-0014：仅 UI 展示，不参与路由）——
# ADR-0012 v0.3.0：删除 VITE_ENABLE_MSW（Service Worker 模式已删除）
VITE_API_MODE=msw-http

# —— saas-identity-platform（SSO 跳转目标） ——
# msw handler 走 process.env.SAAS_BASE_URL；前端走 import.meta.env.VITE_SAAS_BASE_URL
# 本地 saas dev server 默认 :3000；改部署时填实际地址
VITE_SAAS_BASE_URL=http://localhost:3000
SAAS_BASE_URL=http://localhost:3000

# —— OAuth 2.0 client_id ——
# saas V014/V015 seed 收敛 apps.client_id=固定 UUID(3 个 saas 后端共用);
# 前端必须发同一 UUID,否则 saas-aspnetcore authorize 端点 查 apps miss 返 401。
# 与 lab-nextjs src/app/api/auth/sso/authorize/route.ts 一致(2026-08-29 修 prod 401)。
VITE_SAAS_CLIENT_ID=11111111-1111-1111-1111-111111111111