# lab-management-system-react — 开发期环境变量模板
#
# 用法：
#   cp .env.example .env.local
#   编辑 .env.local 填实际值（dev port / 各后端地址 / saas 地址）
#
# Vite 只会把 VITE_ 前缀的变量暴露到 import.meta.env；其他走 process.env。
# msw handler（node-side）走 process.env，前端代码走 import.meta.env.VITE_*。
# 生产期通过部署平台设置同名变量覆盖。

# —— Dev server ——
# Vite dev server 端口；后端 BrowserRouter/Routing 不依赖端口，但与同源 API 路由有关
VITE_DEV_PORT=5173

# —— 后端切换 ——
# 启动时激活后端（msw / nextjs / aspnetcore / springboot）
# localStorage["lab.backend"] 在运行期可被 BackendSwitcher 覆盖
VITE_DEFAULT_BACKEND=msw

# —— 各后端 baseUrl ——
# 空串 = 同源（msw service worker 拦截 / nextjs 的 Next.js API routes 同源）
# 改成本地部署时按实际 IP:PORT 填
VITE_BACKEND_URL_MSW=
VITE_BACKEND_URL_NEXTJS=
VITE_BACKEND_URL_ASPNETCORE=http://localhost:5000
VITE_BACKEND_URL_SPRINGBOOT=http://localhost:8080

# —— saas-identity-platform（SSO 跳转目标） ——
# msw handler 走 process.env.SAAS_BASE_URL；前端走 import.meta.env.VITE_SAAS_BASE_URL
# 本地 saas dev server 默认 :3000；改部署时填实际地址
VITE_SAAS_BASE_URL=http://localhost:3000
SAAS_BASE_URL=http://localhost:3000