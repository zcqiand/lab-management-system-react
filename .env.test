# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# Phase 2 单测真化（spec §3.2 / Task 7）：baseUrl 指真 nextjs :5201（真服务由
# tests/global-setup.ts 保证在位：灌种子 + 探活 + 铸真 JWT）。jsdom 侧已同步
# 同源化（vitest.config.ts url=:5201）——过渡期既有 dom 测试仍被 setup.dom.ts
# 的 msw wildcard handler 拦截（同源绝对 URL 照常命中），T8/T9 拆 msw 后真链路
# 直连。VITE_API_MODE 仅 UI 显示标签（backend-config.ts）。

VITE_API_BASE_URL=http://localhost:5201
VITE_API_MODE=nextjs
VITE_SAAS_BASE_URL=http://localhost:5101
SAAS_BASE_URL=http://localhost:5101

# Vite dev server 端口(与 .env.example 对齐)
VITE_DEV_PORT=5202
# OAuth client_id (与 .env.example 对齐)
VITE_SAAS_CLIENT_ID=lab-management
