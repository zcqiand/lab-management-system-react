# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# ADR-0014 + ADR-0012 v0.3.0：dev 用 .env.local（react → lab-msw HTTP :5173, MSW 模式 off）；
# test 用 .env.test（同源空 baseUrl，触发 @lab/management-system-msw/node setupServer）。
# ADR-0012 v0.3.0：删除 VITE_ENABLE_MSW（Service Worker 模式已删除，setupNodeMocks 无条件启用）。

VITE_API_BASE_URL=
VITE_API_MODE=msw-http
VITE_SAAS_BASE_URL=http://localhost:3000
SAAS_BASE_URL=http://localhost:3000

# Vite dev server 端口(与 .env.example 对齐)
VITE_DEV_PORT=5173