# .env.test — vitest 测试期覆盖（vitest mode=test 时加载，优先级高于 .env.local）
#
# ADR-0014：dev 用 .env.local（react → springboot, MSW off）；
# test 用 .env.test（MSW on + 同源空 baseUrl，触发 @lab/management-system-msw/node）。
# 这样 dev 与 test 互不干扰。

VITE_API_BASE_URL=
VITE_ENABLE_MSW=true
VITE_API_MODE=msw
VITE_SAAS_BASE_URL=http://localhost:3000